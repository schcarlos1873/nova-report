{
  "$schema": "https://novareport.io/schemas/v1/report.json",
  "schemaVersion": "1.0",
  "meta": {
    "title": "Vendas por Região e Cliente",
    "description": "Exemplo completo: grupos aninhados, totais, formatação condicional e tabela-resumo.",
    "author": "NovaReport",
    "paperSize": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 10.0,
      "bottom": 10.0,
      "left": 15.0,
      "right": 15.0
    }
  },
  "dataSources": [
    {
      "id": "ds_vendas",
      "provider": "sqlite",
      "options": {
        "path": "vendas.db"
      },
      "queries": [
        {
          "name": "Pedidos",
          "sql": "SELECT r.nome AS regiao, c.nome AS cliente, c.cidade, p.id AS pedido, p.data, pr.descricao AS produto, p.quantidade, p.valor_total, p.status FROM pedidos p JOIN clientes c ON c.id = p.cliente_id JOIN regioes r ON r.id = c.regiao_id JOIN produtos pr ON pr.id = p.produto_id WHERE p.data BETWEEN :data_inicio AND :data_fim ORDER BY r.nome, c.nome, p.data"
        },
        {
          "name": "ResumoProdutos",
          "sql": "SELECT pr.descricao AS produto, SUM(p.quantidade) AS qtd, SUM(p.valor_total) AS total FROM pedidos p JOIN produtos pr ON pr.id = p.produto_id WHERE p.data BETWEEN :data_inicio AND :data_fim GROUP BY pr.descricao ORDER BY total DESC"
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "data_inicio",
      "type": "date",
      "label": "Data inicial",
      "required": true,
      "defaultValue": "2024-01-01"
    },
    {
      "name": "data_fim",
      "type": "date",
      "label": "Data final",
      "required": true,
      "defaultValue": "2024-12-31"
    }
  ],
  "groups": [
    {
      "name": "regiao",
      "expression": "Fields.regiao"
    },
    {
      "name": "cliente",
      "expression": "Fields.cliente"
    }
  ],
  "bands": [
    {
      "id": "report_header_1",
      "type": "reportHeader",
      "height": 26.0,
      "elements": [
        {
