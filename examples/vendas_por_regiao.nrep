          "type": "image",
          "source": "logo.svg",
          "fit": "contain",
          "x": 0.0,
          "y": 2.0,
          "width": 36.0,
          "height": 12.0,
          "style": {
            "fontFamily": "Arial",
            "fontSize": 10.0,
            "bold": false,
            "italic": false,
            "underline": false,
            "color": "#000000",
            "align": "left",
            "verticalAlign": "top",
            "borderWidth": 0.0,
            "borderColor": "#000000",
            "padding": 0.0
