      "type": "reportFooter",
      "height": 40.0,
      "elements": [
        {
          "id": "geral_fundo",
          "type": "rectangle",
          "radius": 1.5,
          "x": 0.0,
          "y": 3.0,
          "width": 180.0,
          "height": 10.0,
          "style": {
