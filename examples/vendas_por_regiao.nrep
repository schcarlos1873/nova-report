          "type": "expression",
          "expression": "\"TOTAL GERAL · \" + COUNT() + \" pedidos · \" + DISTINCT_COUNT('cliente') + \" clientes\"",
          "x": 4.0,
          "y": 5.5,
          "width": 110.0,
          "height": 6.0,
