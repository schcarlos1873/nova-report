{
  "$schema": "https://novareport.io/schemas/v1/report.json",
  "schemaVersion": "1.0",
  "meta": {
    "title": "semi-acabado.nrep",
    "description": "Relatório de semiacabado",
    "author": "Carlos A. Schnaider",
    "paperSize": "A4",
    "orientation": "landscape",
    "margins": {
      "top": 10.0,
      "bottom": 10.0,
      "left": 15.0,
      "right": 15.0
    }
  },
  "dataSources": [
    {
      "id": "dbmesqas",
      "provider": "mssql",
      "connectionRef": "dbmesqas",
      "options": {
        "path": ""
      },
      "queries": [
        {
          "name": "MastFactory",
          "sql": "select mf.Id, mf.Code from MastFactory mf where mf.IsActive = 1 order by mf.Code"
        },
        {
          "name": "MastMachineType",
          "sql": "select mmt.Id, mmt.Code from MastMachineType mmt where mmt.IsActive = 1"
        },
        {
          "name": "MastMachine",
          "sql": "select m.Id, m.Code from MastMachine m where m.IsActive = 1 and m.FactoryId in (:factoryId) and m.MachineTypeId in (:machineType)"
        },
        {
          "name": "ProdUnit",
          "sql": "select mm.Code MachineId\n, pu.UnitNum\n, pu.WoundDateTime, pu.WidthActual\n, pu.DiameterActual , pu.LengthLinear\n, pu.WeightEstimated , pu.WeightScaled \n, pu.ScaledDateTime , pu.BSWActual \n, mm.Code MachineCode, pu.CreatedBy  \n, soh.OrderNum, soi.OrderItemNum \n, mgs.Code GradeSpec, mgs.BSWNominal, mgs.Caliper  \n, mp.WidthActual RollWidth, mp.LengthLineal RollLength\n, mp.RollsPerPack , mp.DiameterActual RollDiam\n, mp.Weight ProductWeigth\n, prh.Run, pat.Pattern \nfrom ProdUnit pu \ninner join MastMachine mm on pu.MachineId  = mm.Id\ninner join PlanRunPosition  prp on prp.Id = pu.RunPositionId\ninner join PlanRunPattern pat on pat.Id = prp.RunPatternId\ninner join PlanRunHeader prh on prh.Id = pat.RunHeaderId\ninner join ServOrderItem soi on soi.Id  = pu.OrderItemId \ninner join ServOrderHeader soh on soh.Id = soi.OrderId \ninner join MastGradeSpec mgs on mgs.Id =  prh.GradeSpecId \ninner join MastProduct mp on mp.Id = soi.ProductId \nWHERE pu.MachineId  in (:machineId) and pu.WoundDateTime between :beginDate and :endDate\nORDER BY MachineId, pu.WoundDateTime "
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "factoryId",
      "type": "string",
      "label": "Fábrica",
      "required": true,
      "availableValues": {
        "query": "MastFactory",
        "valueField": "Id",
        "labelField": "Code"
      }
    },
    {
      "name": "machineType",
      "type": "string",
      "label": "Tipo de Máquina",
      "required": true,
      "availableValues": {
        "query": "MastMachineType",
        "valueField": "Id",
        "labelField": "Code"
      }
    },
    {
      "name": "machineId",
      "type": "int",
      "label": "Máquina:",
      "required": true,
      "multiValue": true,
      "dependsOn": [
        "factoryId",
        "machineType"
      ],
      "availableValues": {
        "query": "MastMachine",
        "valueField": "Id",
        "labelField": "Code"
      }
    },
    {
      "name": "beginDate",
      "type": "datetime",
      "label": "Data Inicial:",
      "required": false
    },
    {
      "name": "endDate",
      "type": "datetime",
      "label": "Data Final:",
      "required": false
    }
  ],
  "groups": [
    {
      "name": "Machine",
      "expression": "Fields.MachineId"
    }
  ],
