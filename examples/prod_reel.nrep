{
  "$schema": "https://novareport.io/schemas/v1/report.json",
  "schemaVersion": "1.0",
  "meta": {
    "title": "Produção de Jumbos",
    "paperSize": "A4",
    "orientation": "landscape",
    "margins": {
      "top": 10.0,
      "bottom": 10.0,
      "left": 15.0,
      "right": 15.0
    }
  },
  "dataSources": [
    {
      "id": "Dbmesqas",
      "provider": "mssql",
      "connectionRef": "dbmesqas",
      "options": {
        "path": ""
      },
      "queries": [
        {
          "name": "ProdReel",
          "sql": "select mm.Code MachineId, pr.ReelNum, pr.TurnupDateBegin, pr.TurnupDateEnd, pr.WeightTurnup, pr.WidthTurnup,\npr.DiameterTurnup, pr.CreatedBy  \nfrom ProdReel pr \ninner join MastMachine mm on pr.MachineId  = mm.Id\nwhere pr.TurnupDateBegin >= :BeginDate and pr.TurnupDateEnd <= :EndDate"
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "BeginDate",
      "type": "date",
      "label": "Data Inicial:",
      "required": true,
      "defaultValue": "2026-10-01"
    },
    {
      "name": "EndDate",
      "type": "date",
      "label": "Data Final",
      "required": false,
      "defaultValue": "2026-10-05"
    }
  ],
  "groups": [
    {
      "name": "Maquina",
      "expression": "Fields.MachineId",
      "pageBreakBetween": true
    }
  ],
  "bands": [
